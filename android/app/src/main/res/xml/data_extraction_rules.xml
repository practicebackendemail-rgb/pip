<?xml version="1.0" encoding="utf-8"?>
<!-- Pip's database is encrypted with a key held in the Android Keystore, which
     is never backed up or transferred. Restoring the database without its key
     leaves an unreadable file, so nothing is backed up or transferred; users
     move data with Pip's own encrypted backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
