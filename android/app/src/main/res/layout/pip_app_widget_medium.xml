<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (4x2): Pip, its line, the open-task count and the next three tasks.
     Tapping a task ticks it off without opening the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pip_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pip_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pip_widget_face"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:contentDescription="Pip"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pip_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E8ECEB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pip_widget_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9FB0B3"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pip_widget_mic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/pip_widget_mic_bg"
            android:contentDescription="Talk to Pip"
            android:padding="8dp"
            android:src="@drawable/pip_widget_mic" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pip_task_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pip_widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#E2A826"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pip_task_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECEB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pip_task_0_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FB0B3"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pip_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pip_widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#E2A826"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pip_task_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECEB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pip_task_1_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FB0B3"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pip_task_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pip_widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#E2A826"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pip_task_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECEB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pip_task_2_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FB0B3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
